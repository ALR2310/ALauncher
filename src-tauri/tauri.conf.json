{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ALauncher",
  "version": "1.3.0",
  "identifier": "com.alr.alauncher",
  "build": {
    "beforeDevCommand": "yarn build && yarn dev",
    "devUrl": "http://localhost:2310"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.png"],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi"
      }
    },
    "resources": {
      "../dist/": ""
    }
  }
}
